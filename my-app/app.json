{
  "expo": {
    "name": "QUIZIMA",
    "slug": "quizima",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "quizima",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.quizima.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-notifications"
    ],
    "extra": {
      "API_BASE_URL": "https://proyecto-4to-a-o-production.up.railway.app",
      "router": {},
      "eas": {
        "projectId": "5656db98-570e-40e4-b357-9708e4e29a06"
      }
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "owner": "jeff_b4nk"
  }
}
